#!/bin/sh

#
# Devtools installation script.
#
# WARNING: Existing devtools configurations will be overwritten by symlinks to
# the configurations in this repository. However, backups will be created
# of any existing configuration files before they are replaced.
#

# This is required for the `ln` command to generate proper symlinks in
# MSysGit / Git Bash for Windows. Without this configuration the `ln` command
# in this runtime environment will create copies of the dotfiles, rather than
# symlinks to them.

windows() { [ -n "$WINDIR" ]; }
if windows; then
  export MSYS=winsymlinks:nativestrict
fi

# Absolute path to this script,
# eg `/path/to/devtools/run/install`.

FILE_PATH=$(readlink -f "$0")

# Absolute path to the repository root (one directory up from this script),
# eg `/path/to/devtools`.

DIR_PATH=$(dirname "$(dirname "$FILE_PATH")")

# Accumulates failures across all symlink operations. Each `ln` command appends
# `|| errors=1` so that a single failure does not abort subsequent operations.
# The result is checked once at the end.

errors=0

# This script takes no arguments.

if [ $# -gt 0 ]; then
  echo "Error: unknown argument '$1'." >&2
  exit 1
fi

# Create backups of config files that will be replaced by symlinks. The
# `--no-clobber` option ensures existing backups are not overwritten. Symbolic
# links are followed (`--dereference`) to backup the actual files, not the
# symlinks. Errors are suppressed because it is okay for the source files
# to not exist.

#
# Claude
#

mkdir -p ~/.claude
cp --no-clobber --dereference ~/.claude/settings.json ~/.claude/settings.json.bak 2> /dev/null
ln --symbolic --force "${DIR_PATH}/etc/claude/settings.json" ~/.claude/settings.json || errors=1

#
# Docker Desktop
#

mkdir -p ~/.docker/desktop
cp --force "${DIR_PATH}/etc/docker/desktop/settings-store.json" ~/.docker/desktop/settings-store.json || errors=1

#
# Ghostty
#

mkdir -p ~/.config/ghostty
cp --no-clobber --dereference ~/.config/ghostty/config.ghostty ~/.config/ghostty/config.ghostty.bak 2> /dev/null
ln --symbolic --force "${DIR_PATH}/etc/ghostty/config.ghostty" ~/.config/ghostty/config.ghostty || errors=1

#
# LazyGit
#

mkdir -p ~/.config/lazygit
cp --no-clobber --dereference ~/.config/lazygit/config.yml ~/.config/lazygit/config.yml.bak 2> /dev/null
ln --symbolic --force "${DIR_PATH}/etc/lazygit/config.yml" ~/.config/lazygit/config.yml || errors=1

#
# Neovim
#

mkdir -p ~/.config/nvim
cp --no-clobber --dereference ~/.config/nvim/init.vim ~/.config/nvim/init.vim.bak 2> /dev/null
ln --symbolic --force "${DIR_PATH}/etc/nvim/init.vim" ~/.config/nvim/init.vim || errors=1

#
# Ollama
#

mkdir -p ~/.ollama
cp --no-clobber --dereference ~/.ollama/config.json ~/.ollama/config.json.bak 2> /dev/null
ln --symbolic --force "${DIR_PATH}/etc/ollama/config.json" ~/.ollama/config.json || errors=1

#
# Pi
#

mkdir -p ~/.pi/agent
cp --no-clobber --dereference ~/.pi/agent/settings.json ~/.pi/agent/settings.json.bak 2> /dev/null
cp --no-clobber --dereference ~/.pi/agent/models.json ~/.pi/agent/models.json.bak 2> /dev/null
ln --symbolic --force "${DIR_PATH}/etc/pi/settings.json" ~/.pi/agent/settings.json || errors=1
ln --symbolic --force "${DIR_PATH}/etc/pi/models.json" ~/.pi/agent/models.json || errors=1


#
# Qwen
#

mkdir -p ~/.qwen
cp --no-clobber --dereference ~/.qwen/settings.json ~/.qwen/settings.json.bak 2> /dev/null
ln --symbolic --force "${DIR_PATH}/etc/qwen/settings.json" ~/.qwen/settings.json || errors=1

#
# tmux
#

mkdir -p ~/.tmux

cp --no-clobber --dereference ~/.tmux.conf ~/.tmux.conf.bak 2> /dev/null
cp --no-clobber --dereference ~/.tmux/layout ~/.tmux/layout.bak 2> /dev/null

ln --symbolic --force "${DIR_PATH}/etc/tmux/tmux.conf" ~/.tmux.conf || errors=1
ln --symbolic --force "${DIR_PATH}/etc/tmux/inc/layout" ~/.tmux/layout || errors=1

#
# VS Code
#

mkdir -p ~/.config/Code/User/snippets

cp --no-clobber --dereference ~/.config/Code/User/settings.json ~/.config/Code/User/settings.json.bak 2> /dev/null
cp --no-clobber --dereference ~/.config/Code/User/keybindings.json ~/.config/Code/User/keybindings.json.bak 2> /dev/null
cp --no-clobber --dereference ~/.config/Code/User/chatLanguageModels.json ~/.config/Code/User/chatLanguageModels.json.bak 2> /dev/null
cp --no-clobber --dereference ~/.config/Code/User/snippets/global.code-snippets ~/.config/Code/User/snippets/global.code-snippets.bak 2> /dev/null

ln --symbolic --force "${DIR_PATH}/etc/vscode/settings.json" ~/.config/Code/User/settings.json || errors=1
ln --symbolic --force "${DIR_PATH}/etc/vscode/keybindings.json" ~/.config/Code/User/keybindings.json || errors=1
ln --symbolic --force "${DIR_PATH}/etc/vscode/chatLanguageModels.json" ~/.config/Code/User/chatLanguageModels.json || errors=1
ln --symbolic --force "${DIR_PATH}/etc/vscode/global.code-snippets" ~/.config/Code/User/snippets/global.code-snippets || errors=1

#
# VS Codium
#

mkdir -p ~/.config/VSCodium/User/snippets

cp --no-clobber --dereference ~/.config/VSCodium/User/settings.json ~/.config/VSCodium/User/settings.json.bak 2> /dev/null
cp --no-clobber --dereference ~/.config/VSCodium/User/keybindings.json ~/.config/VSCodium/User/keybindings.json.bak 2> /dev/null
cp --no-clobber --dereference ~/.config/VSCodium/User/chatLanguageModels.json ~/.config/VSCodium/User/chatLanguageModels.json.bak 2> /dev/null
cp --no-clobber --dereference ~/.config/VSCodium/User/snippets/global.code-snippets ~/.config/VSCodium/User/snippets/global.code-snippets.bak 2> /dev/null

ln --symbolic --force "${DIR_PATH}/etc/vscode/settings.json" ~/.config/VSCodium/User/settings.json || errors=1
ln --symbolic --force "${DIR_PATH}/etc/vscode/keybindings.json" ~/.config/VSCodium/User/keybindings.json || errors=1
ln --symbolic --force "${DIR_PATH}/etc/vscode/chatLanguageModels.json" ~/.config/VSCodium/User/chatLanguageModels.json || errors=1
ln --symbolic --force "${DIR_PATH}/etc/vscode/global.code-snippets" ~/.config/VSCodium/User/snippets/global.code-snippets || errors=1

#
# Zed
#

mkdir -p ~/.config/zed/snippets

cp --no-clobber --dereference ~/.config/zed/settings.json ~/.config/zed/settings.json.bak 2> /dev/null
cp --no-clobber --dereference ~/.config/zed/snippets/snippets.json ~/.config/zed/snippets/snippets.json.bak 2> /dev/null

ln --symbolic --force "${DIR_PATH}/etc/zed/settings.json" ~/.config/zed/settings.json || errors=1
ln --symbolic --force "${DIR_PATH}/etc/zed/snippets.json" ~/.config/zed/snippets/snippets.json || errors=1

#
# Outcome - Warn the user if one or more symlink generations failed.
#

if [ $errors -ne 0 ]; then
  echo "Failed to create one or more symbolic links. Try again with elevated privileges."
else
  echo "== Installed devtools =="
  echo "Restart your applications for all changes to take effect."
fi
