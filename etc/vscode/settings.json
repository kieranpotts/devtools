{
  /* ---------------------------------------------------------------------------
  Project-specific configuration.

  The following settings are related to conventions for indentation, line
  wrapping, and formatting. Since these concerns tend to be project-specific,
  I have most of these options disabled by default here, then I enable and
  configure them on a per-repository and/or per-workspace basis.
  */

  /* By default, turn off editor rulers (line-wrapping guidelines). */
  "editor.rulers": [],

  /* By default, wrap lines at the edge of the viewport. */
  "editor.wordWrap": "on",

  /* A good default is to have VS Code automatically detect the indentation
  convention of each file. Within repository-level settings, this SHOULD be
  disabled and consistent indentation enforced via this configuration. */
  "editor.detectIndentation": true,

  /* When `editor.detectIndentation` is on, VS Code will determine the following
  settings automatically. But these are still good fallback values. */
  "editor.insertSpaces": true,
  "editor.tabSize": 2,

  /* By default, enable rendering of control characters, and render all empty
  space characters, too. */
  "editor.renderControlCharacters": true,
  "editor.renderWhitespace":"all",

  /* By default, disable all auto-formatting mechanisms. These settings SHOULD
  be re-enabled on a case-by-case basis in repositories and workspaces. See also
  "language-specific settings", below. */
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,
  "editor.formatOnType": false,

  /* Likewise, by default, disable code auto-fixes. */
  "editor.codeActionsOnSave": {
    "source.fixAll": "never"
  },

  /* ---------------------------------------------------------------------------
  Language-specific settings. These also tend to be project-specific.
  */

  /* By default, disable VS Code's built-in formatter and validation for JS
  syntax. Projects are therefore REQUIRED to enable third party formatters and
  validators, such as ESLint, and to configure those tools specifically for
  compatibility with each project's syntax. */
  "js/ts.format.enabled": false,
  "js/ts.validate.enabled": false,

  /* By default, disable the TypeScript type checker in all JavaScript files.
  (This is the default behavior anyway.) Disabling this means that JavaScript
  files MUST include a `@ts-check` comment at the top to opt-in to VS Code's
  built-in `tsc` type checker instance, which will infer type information from
  the code and JSDoc-style notations. Alternatively this setting can be enabled
  on a per-repository or per-workspace basis. */
  "js/ts.implicitProjectConfig.checkJs": false,

  /* Disable auto-closing tags for HTML and JS – consistent with the defaults
  for `editor.autoClosingBrackets` and related settings. It saves typing but
  is often more annoying than it's worth! */
  "html.autoClosingTags": false,
  "js/ts.autoClosingTags.enabled": false,

  /* ---------------------------------------------------------------------------
  Theme and window chrome.
  */

  /* Change the color scheme based on the system's color scheme. See
  `workbench.preferred[**]Theme` settings for additional options. */
  "window.autoDetectColorScheme": true,

  /* Themes. When `window.autoDetectColorScheme` is true, the `colorTheme` option
  is ignored and the `preferred[**]Theme` options are used instead. */
  "workbench.colorTheme": "GitHub Light Default",
  "workbench.preferredLightColorTheme": "GitHub Light Default",
  "workbench.preferredDarkColorTheme": "GitHub Light Colorblind (Beta)",
  "workbench.preferredHighContrastColorTheme": "GitHub Dark High Contrast",
  "workbench.preferredHighContrastLightColorTheme": "GitHub Light High Contrast",
  "workbench.iconTheme": "vs-minimal",
  "window.titleBarStyle": "custom",
  "window.commandCenter": true,
  "window.title": "${dirty}${rootName}${separator}",

  /* Put the menu bar behind a hamburger. */
  "window.menuBarVisibility": "compact",

  /* Apply consistent zoom level to all windows. */
  "window.zoomPerWindow": false,
  "window.zoomLevel": 0,

  /* Use VS Code's non-native dialog windows. */
  "window.dialogStyle": "custom",

  /* Open new VS Code windows maximized. */
  "window.newWindowDimensions": "maximized",

  /* New windows should use the "Default" profile. */
  "window.newWindowProfile": "Default",

  /* Activity Bar position and size. */
  "workbench.activityBar.location": "default",
  "workbench.activityBar.compact": true,

  /* Workbench guides. */
  "workbench.tree.indent": 24,
  "workbench.tree.renderIndentGuides": "always",

  /* Stick scroll within tree views in the side panels. */
  "workbench.tree.enableStickyScroll": true,
  "workbench.tree.stickyScrollMaxItemCount": 3,

  /* Show icons, not labels, in secondary sidebar tabs. */
  "workbench.secondarySideBar.showLabels": false,

  /* Collapse search results, so files must be expanded to show matching text. */
  "search.collapseResults": "alwaysCollapse",

  /* ---------------------------------------------------------------------------
  UI fonts.
  */

  /* Only certain bits of the UI can have its font customized. */
  "chat.fontFamily": "'Maple Mono', 'Droid Sans Mono', monospace",
  "editor.inlineSuggest.fontFamily": "'Maple Mono', 'Droid Sans Mono', monospace",
  "scm.inputFontFamily": "'Maple Mono', 'Droid Sans Mono', monospace",

  /* Change VS Code's UI font. Requires the fonted extension. This is a hack!
  https://marketplace.visualstudio.com/items?itemName=degreat.fonted */
  "fonted.font": "Maple Mono",

  /* ---------------------------------------------------------------------------
  Editors.
  */

  /* Editor font. */
  "editor.fontFamily": "'Maple Mono', 'Droid Sans Mono', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.fontWeight": "300",

  /* Disable various auto-complete mechanisms in the code editor. */
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingDelete": "never",
  "editor.autoClosingOvertype": "never",
  "editor.autoClosingQuotes": "never",
  "editor.autoSurround": "never",

  /* Highlight folded ranges and always base the code folding on indentation level
  rather than language-specific syntax. */
  "editor.foldingHighlight": true,
  "editor.foldingStrategy": "indentation",

  /* Render guidelines for indentation and bracket pairs. */
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": false,
  "editor.guides.bracketPairs": true,

  /* By default, enable inlay hints, which get injected within code
  (eg. showing function parameter names). */
  "editor.inlayHints.enabled": "on",

  /* Show line numbers but hide the minimap. */
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": false,

  /* Good defaults for when the minimap is on. */
  "editor.minimap.size": "fill",
  "editor.minimap.renderCharacters": false,
  "editor.minimap.showSlider": "always",

  /* Disable the breadcrumb trail across the top of editors. */
  "breadcrumbs.enabled": false,

  /* Scrollbar. */
  "editor.scrollbar.vertical": "visible",
  "editor.scrollbar.horizontalScrollbarSize": 14,

  /* Scrolls about 3 lines for every 1 mouse wheel increment. */
  "editor.mouseWheelScrollSensitivity": 1,

  /* Sticky scroll. */
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.maxLineCount": 5,

  /* Prioritize snippet suggestions over all other hints. Pre-select the first.
  Show the toolbar automatically. Turn on tab completion for snippets only.
  ese settings work well with Copilot. */
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.showToolbar": "always",
  "editor.snippetSuggestions": "none",
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.tabCompletion": "onlySnippets",

  /* Enable highlighting of ambiguous characters,
  eg. – (em dash) instead of - (hyphen). */
  "editor.unicodeHighlight.ambiguousCharacters": true,
  "editor.unicodeHighlight.allowedCharacters": {
    "—": true, // Em-dash.
    "–": true // En-dash.
  },

  /* Disable startup editor, which means editors are restored from prior session. */
  "workbench.startupEditor": "none",

  /* ---------------------------------------------------------------------------
  Editor tabs and tab groups.
  */

  /* Shrink tab size as the available space decreases. */
  "workbench.editor.tabSizing": "shrink",

  /* Hide tabs when in Zen mode. */
  "zenMode.showTabs": "none",

  /* ---------------------------------------------------------------------------
  Auto-save and other editing features.
  */

  /* Autosave. */
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 5000,

  /* Limiting file watchers can reduce memory consumption of some language */
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.hg/store/**": true,
    "**/__pycache__/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/venv/**": true
  },

  /* ---------------------------------------------------------------------------
  Diff and merge editor.
  */

  /* Do not use VS Code's new "advanced" diff algorithm just yet – unfortunately
  it's proven to be quite slow at handling very large diffs. */
  "diffEditor.diffAlgorithm": "legacy",
  "mergeEditor.diffAlgorithm": "legacy",

  /* Timeout in milliseconds after which diff computation is cancelled.
  Zero = disabled timeout. */
  "diffEditor.maxComputationTime": 10000, /* 10 seconds */

  /* Mark inline deletions and insertions. */
  "diffEditor.experimental.showEmptyDecorations": true,

  /* Markup blocks of code that have moved to different lines. */
  "diffEditor.experimental.showMoves": true,

  /* Show unchanged regions in the diff editor. */
  "diffEditor.hideUnchangedRegions.enabled": false,

  /* Show diffs inline, rather than side-by-side. */
  "diffEditor.renderSideBySide": false,

  /* Don't ignore trimmed whitespace in the diff. */
  "diffEditor.ignoreTrimWhitespace": false,

  /* ---------------------------------------------------------------------------
  Copilot and AI-assisted coding.
  */

  /* Enable Copilot's next edit suggestions. */
  "github.copilot.nextEditSuggestions.enabled": true,

  /* ---------------------------------------------------------------------------
  Source code management (SCM) and the built-in Git GUI.
  */

  /* By default, prompt for user confirmation before committing directly to
  trunk lines. These are good defaults, but where protected branches are
  configured in the upstream repository, these settings SHOULD be explicitly
  configured at the repository level – to help avoid `git push` failures.
  Other repositories may disable this entirely. */
  "git.branchProtectionPrompt": "alwaysPrompt",
  "git.branchProtection": [
    "main",
    "master",
    "trunk",
    //"dev", -> Allowed for continuous integration.
    "test",
    "ready",
    "release",
    "release/*"
  ],

  /* The default name for new Git branches when created via VS Code's GUI. */
  "git.defaultBranchName": "latest/dev",

  /* Allow overriding of Git hooks on commit operations. */
  "git.allowNoVerifyCommit": true,

  /* Automatically fetch new commits from origin. */
  "git.autofetch": true,

  /* Detect Git repositories in sub-folders. */
  "git.autoRepositoryDetection": "subFolders",

  /* Use temporary stash to enable syncing when working tree is dirty. */
  "git.autoStash": true,

  /* Don't confirm `--no-verify` commits. */
  "git.confirmNoVerifyCommit": false,

  /* Confirm before running sync operation (it may rewrite history). */
  "git.confirmSync": false,

  /* Just go ahead and stage all working changes when committing an empty stage. */
  "git.enableSmartCommit": true,

  /* Remove sync control from status bar. */
  "git.enableStatusBarSync": false,

  /* Sync tags, too. */
  "git.followTagsWhenSync": true,

  /* Use VS Code's new merge editor for resolving conflicts. */
  "git.mergeEditor": true,

  /* Automatically prune references to deleted upstream branches. */
  "git.pruneOnFetch": true,

  /* Enforce rebase strategy on sync, to maintain linear history. */
  "git.rebaseWhenSync": true,

  /* Automatically replace local tags with the remote tags. */
  "git.replaceTagsWhenPull": true,

  /* Scan for Git repositories in sub-folders to a max depth of 3. */
  "git.repositoryScanMaxDepth": 3,

  /* Enable the feature to automatically save and restore open editors when
  switching between source control branches. Since VS Code 1.89.0. This works
  only when a repository is opened in its own workspace, not for multi-root
  workspaces. */
  "scm.workingSets.enabled": true,

  /* When switching new a branch for the first time, close all
  currently-open editors. */
  "scm.workingSets.default": "empty",

  /* Don't require Git user.name and user.email to be set at the repository
  level. Disabling this means we can rely on the global Git configuration,
  which means we can set our Git name and email values once only. */
  "git.requireGitUserConfig": false,

  /* ---------------------------------------------------------------------------
  SettingsSync.
  */

  /* Synchronize keybindings based on the OS. */
  "settingsSync.keybindingsPerPlatform": true,

  /* ---------------------------------------------------------------------------
  Terminals - integrated and external.
  */

  /* Integrated terminal configuration. */
  "terminal.integrated.fontFamily": "Maple Mono NF",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 3,
  "terminal.integrated.defaultLocation": "editor", /* Open in a new editor tab rather than panel. */
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.shellIntegration.enabled": true,

  /* Default profiles for integrated terminal - varies between Windows and WSL/Linux. */
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.windows": "Git Bash",

  /* Use Windows Terminal as the external editor on Windows. */
  "terminal.external.windowsExec": "wt",

  /* Adds "Open in Windows Terminal" to right-click menu of Explorer items. */
  "terminal.explorerKind": "external",

  /* Clear the terminal before running a new debugging session. */
  "debug.terminal.clearBeforeReusing": true,

  /* Sticky-scroll within integrated terminal. */
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.stickyScroll.maxLineCount": 3,

  /* Settings insisted upon by Kilo Code. Add these commands to the list of
  keybindings that will not be sent to the shell, but instead will always be
  handled by VS Code – thus, keybindings like `Ctrl+P` to launch Quick Open
  will work even when the integrated terminal is in focus. */
  "terminal.integrated.commandsToSkipShell": [
    "kilo-code.new.agentManagerOpen",
    "kilo-code.new.agentManager.showTerminal"
  ],

  /* ---------------------------------------------------------------------------
  Notebooks.
  */

  "notebook.stickyScroll.enabled": true,
  "notebook.stickyScroll.mode": "indented",

  /* ---------------------------------------------------------------------------
  External browser.
  */

  /* Open links in Firefox. */
  "workbench.externalBrowser": "firefox",

  /* ---------------------------------------------------------------------------
  Security settings.
  */

  /* Always open untrusted files into a trusted workspace without prompting. */
  "security.workspace.trust.untrustedFiles": "open",

  /* ---------------------------------------------------------------------------
  Extensions and built-in services.
  */

  /* DO show popups for recommended extensions. */
  "extensions.ignoreRecommendations": false,

  /* ---------------------------------------------------------------------------
  Remotes and Dev Containers.
  */

  /* Sets the source from which ports are automatically forwarded when
  Remote: Auto Forward Ports is true (default). This is required for WSL.
  On Windows and macOS remotes, the "process" and "hybrid" options have no
  effect, and "output" will be used. */

  "remote.autoForwardPortsSource": "hybrid",

  /* If you try opening a devcontainer from WSL, VS Code will detect
  WAYLAND_DISPLAY on your Windows host and so try to mount the Wayland
  socket into the container. But Docker can't actually access it through
  the WSL guest layer, resulting in a "Failed to connect to Wayland display"
  error when you try to open a devcontainer for a workspace or directory
  that's located in WSL. The following option, which must be set at the
  user or profile level, disables the Wayland socket mount and so avoids
  this error. This is not a problem as long as you only need CLI access
  to the devcontainer environment. */

  "dev.containers.mountWaylandSocket": false,

  /* ---------------------------------------------------------------------------
  AI agents
  */

  /* Disable GitHub Copilot completions for everything. */
  "github.copilot.enable": {
    "*": false
  },

  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true
  },

  /* Enable/disable GitHub Copilot Chat - it's no longer an extension. AI
  features MUST be enabled for the VS Code Speech extension to work,
  it seems. */
  "chat.disableAIFeatures": false,
  "chat.viewSessions.orientation": "stacked",

  "claudeCode.selectedModel": "haiku",
  "claudeCode.preferredLocation": "panel",

  /* YAML Schema for Continue config. */
  "yaml.schemas": {
    "file:///home/kieran/.vscode/extensions/continue.continue-1.2.22-linux-x64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ]
  },


  /* ---------------------------------------------------------------------------
  Previews
  */

  "markdown.preview.fontFamily": "'Maple Mono', 'Droid Sans Mono', monospace",
  "markdown.preview.fontSize": 17,

  /* Depends on extension: https://marketplace.visualstudio.com/items?itemName=asciidoctor.asciidoctor-vscode */
  "asciidoc.preview.fontFamily": "'Maple Mono', 'Droid Sans Mono', monospace",
  "asciidoc.preview.fontSize": 17,

  /* When previewing Asciidoc files, use VS Code's workbench color theme,
  rather than the default Asciidoc style. This ensures the colors of the
  preview are consistent with the enabled VS Code theme. */
  "asciidoc.preview.useEditorStyle": true

}
