{
  /**
   * Theme and window chrome
   */

  /* Use VS Code's non-native title bar with the command centre in the middle.
  Show only the name of the folder or workspace in the window title bar. */
  "window.titleBarStyle": "custom",
  "window.commandCenter": true,
  "window.title": "${dirty}${rootName}${separator}",

  /* Use VS Code's non-native dialog windows. */
  "window.dialogStyle": "custom",

  /* Open new VS Code windows maximized. */
  "window.newWindowDimensions": "maximized",

  /* Activity Bar position. */
  "workbench.activityBar.location": "top",

  /* Zoom. */
  "window.zoomLevel": 1,

  /* Change the color scheme based on the system's color scheme. See
  workbench.preferred*Theme` settings for additional options. */
  "window.autoDetectColorScheme": true,

  /* Themes. When `window.autoDetectColorScheme` is true, the `colorTheme` option
  is ignored and the `preferred**Theme` options are used instead. */
  "workbench.colorTheme": "GitHub Light",
  "workbench.preferredLightColorTheme": "Ocean Light",
  "workbench.preferredDarkColorTheme": "GitHub Dark",
  "workbench.preferredHighContrastColorTheme": "GitHub Dark High Contrast",
  "workbench.preferredHighContrastLightColorTheme": "GitHub Light High Contrast",
  "workbench.iconTheme": "vs-minimal",

  /* Visual presentation of tree views in panels - eg File Explorer. */
  "workbench.tree.indent": 24,
  "workbench.tree.renderIndentGuides": "always",

  /* Stick scroll within tree views in the side panels. */
  "workbench.tree.enableStickyScroll": true,
  "workbench.tree.stickyScrollMaxItemCount": 3,

  /* Collapse search results, so files must be expanded to show matching text. */
  "search.collapseResults": "alwaysCollapse",

  /**
   * Tabs, tabs groups, and editor.
   */

  /* Disable various auto-complete mechanisms in the code editor. */
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingDelete": "never",
  "editor.autoClosingOvertype": "never",
  "editor.autoClosingQuotes": "never",
  "editor.autoSurround": "never",

  /* Highlight folded ranges and always base code folding on indentation level
  rather than language-specific syntax. */
  "editor.foldingHighlight": true,
  "editor.foldingStrategy": "indentation",

  /* Editor font. */
  "editor.fontFamily": "Hack, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.fontWeight": "400",

  /* Disable all auto-formatting mechanisms by default. This means projects MUST
  enable these features on a per-repo basis. */
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,
  "editor.formatOnType": false,

  /* Disable auto-fixes by default, so also requiring individual projects to
  explicitly opt-in to this feature. */
  "editor.codeActionsOnSave": {
    "source.fixAll": "never"
  },

  /* Render guidelines for indentation and bracket pairs. */
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": false,
  "editor.guides.bracketPairs": true,

  /* By default, disable inlay hints, which get injected within code
  (eg showing function parameter names). */
  "editor.inlayHints.enabled": "on",

  /* Show line numbers and the minimap. */
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.size": "fit",
  "editor.minimap.showSlider": "always",

  /* Disable the breadcrumb trail across the top of editors. */
  "breadcrumbs.enabled": false,

  /* Scrollbar. */
  "editor.scrollbar.vertical": "visible",
  "editor.scrollbar.horizontalScrollbarSize": 14,

  /* Scrolls about 3 lines for every 1 mouse wheel increment. */
  "editor.mouseWheelScrollSensitivity": 1,

  /* Sticky scroll. */
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 5,

  /* Render control and empty space characters. */
  "editor.renderControlCharacters": true,
  "editor.renderWhitespace": "all",

  /* Disable vertical guidelines by default. These SHOULD be configured on a
  per-repository basis. */
  "editor.rulers": [],

  /* Prioritize snippet suggestions over all other hints. Pre-select the first.
  Show the toolbar automatically – this works well with Copilot. */
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.showToolbar": "always",
  "editor.snippetSuggestions": "none",
  "editor.suggestSelection": "recentlyUsedByPrefix",

  /* Turn on tab completion for snippets. */
  "editor.tabCompletion": "onlySnippets",

  /* By default, do not transform tabs to spaces. The purpose here is to
  enforce this policy on a repo-by-repo basis. */
  "editor.detectIndentation": false,
  "editor.insertSpaces": false,

  /* Rules for highlighting special unicode characters. Don't warn about use
  of en-dash (–) and em-dash (—) characters in code. I use these characters
  in comments pretty frequently. */
  "editor.unicodeHighlight.allowedCharacters": {
    "–": true,
    "—": true,
  },

  /* Wrap long lines at the viewport but up to maximum of 120 characters. */
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,

  /* AsciiDoc line wrap config must be defined separately. */
  "[asciidoc]": {
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 80
  },

  /* Markdown line wrap config must be defined separately. */
  "[markdown]": {
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 80
  },

  /* Shrink tab size as the available space decreases. */
  "workbench.editor.tabSizing": "shrink",

  /* Disable startup editor, which means editors are restored from prior session. */
  "workbench.startupEditor": "none",

  /* Hide tabs when in Zen mode. */
  "zenMode.showTabs": "none",

  /**
   * Auto-save and other editing features
   */

  /* Autosave. */
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 5000,

  /**
   * Diff and Merge Editor
   */

  /* Use VS Code's improved diff algorithm for the old diff editor
  as well as the new one. */
  "diffEditor.diffAlgorithm": "advanced",

  /* Mark inline deletions and insertions. */
  "diffEditor.experimental.showEmptyDecorations": true,

  /* Markup blocks of code that have moved to different lines. */
  "diffEditor.experimental.showMoves": true,

  /* Show unchanged regions in the diff editor. */
  "diffEditor.hideUnchangedRegions.enabled": true,

  /**
   * Source code management (SCM) and the built-in Git GUI.
   */

  /* Default name for new Git branches when created via VS Code's GUI. */
  "git.defaultBranchName": "dev",

  /* Allow overriding of Git hooks on commit operations. */
  "git.allowNoVerifyCommit": true,

  /* Automatically fetch new commits from origin. */
  "git.autofetch": true,

  /* Detect Git repositories in sub-folders. */
  "git.autoRepositoryDetection": "subFolders",

  /* Use temporary stash to enable syncing when working tree is dirty. */
  "git.autoStash": true,

  /* Don't confirm `--no-verify` commits. */
  "git.confirmNoVerifyCommit": false,

  /* Confirm before running sync operation (it may rewrite history). */
  "git.confirmSync": false,

  /* Commit all working changes when nothing is yet staged. */
  "git.enableSmartCommit": true,

  /* Remove sync control from status bar. */
  "git.enableStatusBarSync": false,

  /* Sync tags, too. */
  "git.followTagsWhenSync": true,

  /* Use VS Code's new merge editor for resolving conflicts. */
  "git.mergeEditor": true,

  /* Automatically prune references to deleted upstream branches. */
  "git.pruneOnFetch": true,

  /* Enforce rebase strategy on sync, to maintain linear history. */
  "git.rebaseWhenSync": true,

  /* Scan for Git repositories in sub-folders to a max depth of 3. */
  "git.repositoryScanMaxDepth": 3,

  /* Enable the feature to automatically save and restore open editors when
  switching between source control branches. Since VS Code 1.89.0. */
  "scm.workingSets.enabled": true,

  /* When switching new a branch for the first time, close all currently-open editors. */
  "scm.workingSets.default": "empty",

  /**
   * Terminal
   */

  /* Integrated terminal configuration. */
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 3,
  "terminal.integrated.defaultLocation": "editor", /* Open in a new editor tab rather than panel. */
  "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.fontFamily": "Hack NF",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.shellIntegration.enabled": true,

  /* Use Windows Terminal as the external editor. */
  "terminal.external.windowsExec": "wt",

  /* Adds "Open in Windows Terminal" to right-click menu of Explorer items. */
  "terminal.explorerKind": "external",

  /* Clear the terminal before running a new debugging session. */
  "debug.terminal.clearBeforeReusing": true,

  /* Sticky-scroll within integrated terminal. */
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.stickyScroll.maxLineCount": 3,

  /**
   * Notebooks
   */

   "notebook.stickyScroll.enabled": true,
   "notebook.stickyScroll.mode": "indented",

  /**
   * External browser
   */

  /* Open links in Firefox. */
  "workbench.externalBrowser": "firefox",

  /**
   * Extensions and built-in services
   */

  /* Don't show recommended extensions. */
  "extensions.ignoreRecommendations": false,

  /* Synchronize keybindings based on the OS. */
  "settingsSync.keybindingsPerPlatform": true,

  /**
   * Language-specific settings
   */

  /* Disable auto-closing tags. */
  "html.autoClosingTags": false,
  "javascript.autoClosingTags": false,

  /* By default, disable VS Code's built-in formatter and validation for JavaScript
  syntax. Projects are therefore REQUIRED to enable third party formatters and
  validators, such as ESLint, and to configure those tools specifically for
  for compatibility with each project's syntax. */
  "javascript.format.enable": false,
  "javascript.validate.enable": false,

  /* Disable the TypeScript type checker in all JavaScript files by default.
  (This is the default behavior anyway.) Disabling this means that JavaScript
  files MUST include a `@ts-check` comment at the top to opt-in to VS Code's
  built-in `tsc` type checker instance, which will infer type information from
  the code and JSDoc-style notations. */
  "js/ts.implicitProjectConfig.checkJs": false,

  /**
   * Extension settings
   */

  /* --- Asciidoc extension ---
  https://marketplace.visualstudio.com/items?itemName=asciidoctor.asciidoctor-vscode */

  /* Enable support for embedded diagrams in AsciiDoc, via Kroki.
  This needs to be enabled at the user or workspace level.
  https://marketplace.visualstudio.com/items?itemName=asciidoctor.asciidoctor-vscode */
  "asciidoc.extensions.enableKroki": true,
  "asciidoc.preview.asciidoctorAttributes": {
    //"kroki-server-url": "https://kroki.io",
    "kroki-server-url": "http://localhost:8080",
  },

  /* When previewing Asciidoc files, use VS Code's built-in preview style
  rather than the default Asciidoc style. This ensures the colors of the
  preview are consistent with the enabled VS Code theme. */
  "asciidoc.preview.useEditorStyle": true,

  /* Enable Antora support. */
  "asciidoc.antora.enableAntoraSupport": true,

  /* --- GitHub Copilot extension ---
  https://marketplace.visualstudio.com/items?itemName=GitHub.copilot */

  "github.copilot.enable": {
    "*": true,
    "enableAutoCompletions": true,
    "plaintext": true,
    "asciidoc": true,
    "markdown": true,
  },

  "github.copilot.editor.enableAutoCompletions": true,

  "github.copilot.advanced": {
    "debug.showScores": true,
    "inlineSuggestCount": 12,
    "listCount": 12,
  },

  /* --- PlantUML extension ---
  https://marketplace.visualstudio.com/items?itemName=jebbs.plantuml */

  // "plantuml.server": "https://www.plantuml.com/plantuml",
  "plantuml.server": "http://localhost:8080",
  "plantuml.render": "PlantUMLServer"

}
