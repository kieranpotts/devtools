{"name":"default","settings":"{\"settings\":\"{\\n  /* ---------------------------------------------------------------------------\\n  Project-specific configuration.\\n\\n  The following settings are related to conventions for indentation, line\\n  wrapping, and formatting. Since these concerns tend to be project-specific,\\n  I have most of these options disabled by default here, then I enable and\\n  configure them on a per-repository and/or per-workspace basis.\\n  */\\n\\n  /* By default, turn off editor rulers (line-wrapping guidelines). */\\n  \\\"editor.rulers\\\": [],\\n\\n  /* By default, wrap lines at the edge of the viewport. */\\n  \\\"editor.wordWrap\\\": \\\"on\\\",\\n\\n  /* A good default is to have VS Code automatically detect the indentation\\n  convention of each file. Within repository-level settings, this SHOULD be\\n  disabled and consistent indentation enforced. */\\n  \\\"editor.detectIndentation\\\": true,\\n\\n  /* When `editor.detectIndentation` is on, VS Code will determine the following\\n  settings automatically. The following settings are still good fallbacks. */\\n  \\\"editor.insertSpaces\\\": true,\\n  \\\"editor.tabSize\\\": 2,\\n\\n  /* By default, enable rendering of control characters, and render all empty\\n  space characters, too. */\\n  \\\"editor.renderControlCharacters\\\": true,\\n  \\\"editor.renderWhitespace\\\":\\\"all\\\",\\n\\n  /* By default, disable all auto-formatting mechanisms. These settings SHOULD\\n  be re-enabled on a case-by-case basis in repositories and workspaces. See also\\n  \\\"language-specific settings\\\", below. */\\n  \\\"editor.formatOnPaste\\\": false,\\n  \\\"editor.formatOnSave\\\": false,\\n  \\\"editor.formatOnType\\\": false,\\n\\n  /* Likewise, by default, disable code auto-fixes. */\\n  \\\"editor.codeActionsOnSave\\\": {\\n    \\\"source.fixAll\\\": \\\"never\\\"\\n  },\\n\\n  /* ---------------------------------------------------------------------------\\n  Language-specific settings. These also tend to be project-specific.\\n  */\\n\\n  /* By default, disable VS Code's built-in formatter and validation for JS\\n  syntax. Projects are therefore REQUIRED to enable third party formatters and\\n  validators, such as ESLint, and to configure those tools specifically for\\n  for compatibility with each project's syntax. */\\n  \\\"javascript.format.enable\\\": false,\\n  \\\"javascript.validate.enable\\\": false,\\n\\n  /* By default, disable the TypeScript type checker in all JavaScript files.\\n  (This is the default behavior anyway.) Disabling this means that JavaScript\\n  files MUST include a `@ts-check` comment at the top to opt-in to VS Code's\\n  built-in `tsc` type checker instance, which will infer type information from\\n  the code and JSDoc-style notations. Alternatively this setting can be enabled\\n  on a per-repository or per-workspace basis. */\\n  \\\"js/ts.implicitProjectConfig.checkJs\\\": false,\\n\\n  /* Disable auto-closing tags for HTML and JS – consistent with the defaults\\n  for \\\"editor.autoClosingBrackets\\\" and related settings (see below). It saves\\n  typing but is often more annoying than it's worth! */\\n  \\\"html.autoClosingTags\\\": false,\\n  \\\"javascript.autoClosingTags\\\": false,\\n\\n  /* ---------------------------------------------------------------------------\\n  Theme and window chrome.\\n  */\\n\\n  /* Change the color scheme based on the system's color scheme. See\\n  `workbench.preferred[**]Theme` settings for additional options. */\\n  \\\"window.autoDetectColorScheme\\\": true,\\n\\n  /* Themes. When `window.autoDetectColorScheme` is true, the `colorTheme` option\\n  is ignored and the `preferred[**]Theme` options are used instead. */\\n  \\\"workbench.colorTheme\\\": \\\"Ocean Light\\\",\\n  \\\"workbench.preferredLightColorTheme\\\": \\\"GitHub Light\\\",\\n  \\\"workbench.preferredDarkColorTheme\\\": \\\"GitHub Dark\\\",\\n  \\\"workbench.preferredHighContrastColorTheme\\\": \\\"GitHub Dark High Contrast\\\",\\n  \\\"workbench.preferredHighContrastLightColorTheme\\\": \\\"GitHub Light High Contrast\\\",\\n  \\\"workbench.iconTheme\\\": \\\"vs-minimal\\\",\\n\\n  /* Zoom. */\\n  \\\"window.zoomLevel\\\": 1,\\n\\n  /* Use VS Code's non-native title bar with the command centre in the middle.\\n  Show only the name of the folder or workspace in the window title bar,\\n  when it's visible. */\\n  \\\"window.titleBarStyle\\\": \\\"custom\\\",\\n  \\\"window.commandCenter\\\": true,\\n  \\\"window.title\\\": \\\"${dirty}${rootName}${separator}\\\",\\n\\n  /* Use VS Code's non-native dialog windows. */\\n  \\\"window.dialogStyle\\\": \\\"custom\\\",\\n\\n  /* Open new VS Code windows maximized. */\\n  \\\"window.newWindowDimensions\\\": \\\"maximized\\\",\\n\\n  /* Activity Bar position. */\\n  \\\"workbench.activityBar.location\\\": \\\"top\\\",\\n\\n  /* Visual presentation of tree views in panels - eg File Explorer. */\\n  \\\"workbench.tree.indent\\\": 24,\\n  \\\"workbench.tree.renderIndentGuides\\\": \\\"always\\\",\\n\\n  /* Stick scroll within tree views in the side panels. */\\n  \\\"workbench.tree.enableStickyScroll\\\": true,\\n  \\\"workbench.tree.stickyScrollMaxItemCount\\\": 3,\\n\\n  /* Collapse search results, so files must be expanded to show matching text. */\\n  \\\"search.collapseResults\\\": \\\"alwaysCollapse\\\",\\n\\n  /* ---------------------------------------------------------------------------\\n  Editors.\\n  */\\n\\n  /* Editor font. */\\n  \\\"editor.fontFamily\\\": \\\"Hack, monospace\\\",\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.fontSize\\\": 14,\\n  \\\"editor.fontWeight\\\": \\\"400\\\",\\n\\n  /* Disable various auto-complete mechanisms in the code editor. */\\n  \\\"editor.autoClosingBrackets\\\": \\\"never\\\",\\n  \\\"editor.autoClosingDelete\\\": \\\"never\\\",\\n  \\\"editor.autoClosingOvertype\\\": \\\"never\\\",\\n  \\\"editor.autoClosingQuotes\\\": \\\"never\\\",\\n  \\\"editor.autoSurround\\\": \\\"never\\\",\\n\\n  /* Highlight folded ranges and always base code folding on indentation level\\n  rather than language-specific syntax. */\\n  \\\"editor.foldingHighlight\\\": true,\\n  \\\"editor.foldingStrategy\\\": \\\"indentation\\\",\\n\\n  /* Render guidelines for indentation and bracket pairs. */\\n  \\\"editor.guides.indentation\\\": true,\\n  \\\"editor.guides.highlightActiveIndentation\\\": false,\\n  \\\"editor.guides.bracketPairs\\\": true,\\n\\n  /* By default, enable inlay hints, which get injected within code\\n  (eg. showing function parameter names). */\\n  \\\"editor.inlayHints.enabled\\\": \\\"on\\\",\\n\\n  /* Show line numbers and the minimap. */\\n  \\\"editor.lineNumbers\\\": \\\"on\\\",\\n  \\\"editor.minimap.enabled\\\": true,\\n  \\\"editor.minimap.size\\\": \\\"fill\\\",\\n  \\\"editor.minimap.renderCharacters\\\": false,\\n  \\\"editor.minimap.showSlider\\\": \\\"always\\\",\\n\\n  /* Enable the breadcrumb trail across the top of editors. */\\n  \\\"breadcrumbs.enabled\\\": true,\\n\\n  /* Scrollbar. */\\n  \\\"editor.scrollbar.vertical\\\": \\\"visible\\\",\\n  \\\"editor.scrollbar.horizontalScrollbarSize\\\": 14,\\n\\n  /* Scrolls about 3 lines for every 1 mouse wheel increment. */\\n  \\\"editor.mouseWheelScrollSensitivity\\\": 1,\\n\\n  /* Sticky scroll. */\\n  \\\"editor.stickyScroll.enabled\\\": true,\\n  \\\"editor.stickyScroll.maxLineCount\\\": 5,\\n\\n  /* Prioritize snippet suggestions over all other hints. Pre-select the first.\\n  Show the toolbar automatically. Turn on tab completion for snippets only.\\n  **These settings work well with Copilot.** */\\n  \\\"editor.inlineSuggest.enabled\\\": true,\\n  \\\"editor.inlineSuggest.showToolbar\\\": \\\"always\\\",\\n  \\\"editor.snippetSuggestions\\\": \\\"none\\\",\\n  \\\"editor.suggestSelection\\\": \\\"recentlyUsedByPrefix\\\",\\n  \\\"editor.tabCompletion\\\": \\\"onlySnippets\\\",\\n\\n  /* Enable highlighting of ambiguous characters,\\n  eg. – (em dash) instead of - (hyphen). */\\n  \\\"editor.unicodeHighlight.ambiguousCharacters\\\": true,\\n\\n  /* Disable startup editor, which means editors are restored from prior session. */\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n\\n  /* ---------------------------------------------------------------------------\\n  Editor tabs and tab groups.\\n  */\\n\\n  /* Shrink tab size as the available space decreases. */\\n  \\\"workbench.editor.tabSizing\\\": \\\"shrink\\\",\\n\\n  /* Hide tabs when in Zen mode. */\\n  \\\"zenMode.showTabs\\\": \\\"none\\\",\\n\\n  /* ---------------------------------------------------------------------------\\n  Auto-save and other editing features.\\n  */\\n\\n  /* Autosave. */\\n  \\\"files.autoSave\\\": \\\"afterDelay\\\",\\n  \\\"files.autoSaveDelay\\\": 5000,\\n\\n  /* ---------------------------------------------------------------------------\\n  Diff and merge editor.\\n  */\\n\\n  /* Do not use VS Code's new \\\"advanced\\\" diff algorithm just yet – unfortunately\\n  it's proven to be quite slow at handling very large diffs. */\\n  \\\"diffEditor.diffAlgorithm\\\": \\\"legacy\\\",\\n  \\\"mergeEditor.diffAlgorithm\\\": \\\"legacy\\\",\\n\\n  /* Timeout in milliseconds after which diff computation is cancelled.\\n  Zero = disabled timeout. */\\n  \\\"diffEditor.maxComputationTime\\\": 10000, /* 10 seconds */\\n\\n  /* Mark inline deletions and insertions. */\\n  \\\"diffEditor.experimental.showEmptyDecorations\\\": true,\\n\\n  /* Markup blocks of code that have moved to different lines. */\\n  \\\"diffEditor.experimental.showMoves\\\": true,\\n\\n  /* Show unchanged regions in the diff editor. */\\n  \\\"diffEditor.hideUnchangedRegions.enabled\\\": false,\\n\\n  /* Show diffs inline, rather than side-by-side. */\\n  \\\"diffEditor.renderSideBySide\\\": false,\\n\\n  /* Don't ignore trimmed whitespace in the diff. */\\n  \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\n\\n  /* ---------------------------------------------------------------------------\\n  Source code management (SCM) and the built-in Git GUI.\\n  */\\n\\n  /* By default, prompt for user confirmation before committing directly to\\n  trunk lines. These are good defaults, but where protected branches are\\n  configured in the upstream repository, these settings SHOULD be explicitly\\n  configured at the repository level – to help avoid `git push` failures.\\n  Other repositories may disable this entirely. */\\n  \\\"git.branchProtectionPrompt\\\": \\\"alwaysPrompt\\\",\\n  \\\"git.branchProtection\\\": [\\n    \\\"main\\\",\\n    \\\"master\\\",\\n    \\\"trunk\\\",\\n    \\\"dev\\\",\\n    \\\"release/*\\\"\\n  ],\\n\\n  /* The default name for new Git branches when created via VS Code's GUI. */\\n  \\\"git.defaultBranchName\\\": \\\"dev\\\",\\n\\n  /* Allow overriding of Git hooks on commit operations. */\\n  \\\"git.allowNoVerifyCommit\\\": true,\\n\\n  /* Automatically fetch new commits from origin. */\\n  \\\"git.autofetch\\\": true,\\n\\n  /* Detect Git repositories in sub-folders. */\\n  \\\"git.autoRepositoryDetection\\\": \\\"subFolders\\\",\\n\\n  /* Use temporary stash to enable syncing when working tree is dirty. */\\n  \\\"git.autoStash\\\": true,\\n\\n  /* Don't confirm `--no-verify` commits. */\\n  \\\"git.confirmNoVerifyCommit\\\": false,\\n\\n  /* Confirm before running sync operation (it may rewrite history). */\\n  \\\"git.confirmSync\\\": false,\\n\\n  /* Just go ahead and stage all working changes when committing an empty stage. */\\n  \\\"git.enableSmartCommit\\\": true,\\n\\n  /* Remove sync control from status bar. */\\n  \\\"git.enableStatusBarSync\\\": false,\\n\\n  /* Sync tags, too. */\\n  \\\"git.followTagsWhenSync\\\": true,\\n\\n  /* Use VS Code's new merge editor for resolving conflicts. */\\n  \\\"git.mergeEditor\\\": true,\\n\\n  /* Automatically prune references to deleted upstream branches. */\\n  \\\"git.pruneOnFetch\\\": true,\\n\\n  /* Enforce rebase strategy on sync, to maintain linear history. */\\n  \\\"git.rebaseWhenSync\\\": true,\\n\\n  /* Automatically replace local tags with the remote tags. */\\n  \\\"git.replaceTagsWhenPull\\\": true,\\n\\n  /* Scan for Git repositories in sub-folders to a max depth of 3. */\\n  \\\"git.repositoryScanMaxDepth\\\": 3,\\n\\n  /* Enable the feature to automatically save and restore open editors when\\n  switching between source control branches. Since VS Code 1.89.0. This works\\n  only when a repository is opened in its own workspace, not for multi-root\\n  workspaces. */\\n  \\\"scm.workingSets.enabled\\\": true,\\n\\n  /* When switching new a branch for the first time, close all\\n  currently-open editors. */\\n  \\\"scm.workingSets.default\\\": \\\"empty\\\",\\n\\n  /* ---------------------------------------------------------------------------\\n  Terminals - integrated and external.\\n  */\\n\\n  /* Integrated terminal configuration. */\\n  \\\"terminal.integrated.fontFamily\\\": \\\"Hack NF\\\",\\n  \\\"terminal.integrated.fontSize\\\": 14,\\n  \\\"terminal.integrated.cursorStyle\\\": \\\"line\\\",\\n  \\\"terminal.integrated.cursorWidth\\\": 3,\\n  \\\"terminal.integrated.defaultLocation\\\": \\\"editor\\\", /* Open in a new editor tab rather than panel. */\\n  \\\"terminal.integrated.enableMultiLinePasteWarning\\\": \\\"never\\\",\\n  \\\"terminal.integrated.shellIntegration.enabled\\\": true,\\n\\n  /* Default profiles for integrated terminal - varies between Windows and WSL/Linux. */\\n  \\\"terminal.integrated.defaultProfile.linux\\\": \\\"bash\\\",\\n  \\\"terminal.integrated.defaultProfile.windows\\\": \\\"Git Bash\\\",\\n\\n  /* Use Windows Terminal as the external editor on Windows. */\\n  \\\"terminal.external.windowsExec\\\": \\\"wt\\\",\\n\\n  /* Adds \\\"Open in Windows Terminal\\\" to right-click menu of Explorer items. */\\n  \\\"terminal.explorerKind\\\": \\\"external\\\",\\n\\n  /* Clear the terminal before running a new debugging session. */\\n  \\\"debug.terminal.clearBeforeReusing\\\": true,\\n\\n  /* Sticky-scroll within integrated terminal. */\\n  \\\"terminal.integrated.stickyScroll.enabled\\\": true,\\n  \\\"terminal.integrated.stickyScroll.maxLineCount\\\": 3,\\n\\n  /* ---------------------------------------------------------------------------\\n  Notebooks.\\n  */\\n\\n  \\\"notebook.stickyScroll.enabled\\\": true,\\n  \\\"notebook.stickyScroll.mode\\\": \\\"indented\\\",\\n\\n  /* ---------------------------------------------------------------------------\\n  External browser.\\n  */\\n\\n  /* Open links in Firefox. */\\n  \\\"workbench.externalBrowser\\\": \\\"firefox\\\",\\n\\n  /* ---------------------------------------------------------------------------\\n  Security settings.\\n  */\\n\\n  /* Always open untrusted files into a trusted workspace without prompting. */\\n  \\\"security.workspace.trust.untrustedFiles\\\": \\\"open\\\",\\n\\n  /* ---------------------------------------------------------------------------\\n  Extensions and built-in services.\\n  */\\n\\n  /* Don't show popups for recommended extensions. */\\n  \\\"extensions.ignoreRecommendations\\\": true,\\n\\n  /* Synchronize keybindings based on the OS. */\\n  \\\"settingsSync.keybindingsPerPlatform\\\": true,\\n  \\\"github.copilot.nextEditSuggestions.enabled\\\": true\\n\\n}\\n\"}","keybindings":"{\"keybindings\":\"[\\n  /* Open external terminal in own window (start at current working directory). */\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+t\\\",\\n    \\\"when\\\": \\\"!terminalFocus\\\",\\n    \\\"command\\\": \\\"workbench.action.terminal.openNativeConsole\\\",\\n  },\\n\\n  /* Open external terminal in new tab (start at current working directory). */\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+t\\\",\\n    \\\"when\\\": \\\"terminalProcessSupported\\\",\\n    \\\"command\\\": \\\"workbench.action.terminal.newWithCwd\\\",\\n  },\\n\\n  /* Toggle zen mode. */\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+z\\\",\\n    \\\"command\\\": \\\"workbench.action.toggleZenMode\\\"\\n  },\\n\\n  /* Stage selected range */\\n  {\\n    \\\"key\\\": \\\"ctrl+space\\\",\\n    \\\"when\\\": \\\"isInDiffEditor && editorTextFocus\\\",\\n    \\\"command\\\": \\\"git.stageSelectedRanges\\\",\\n\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+space\\\",\\n    /* Diff editor is in read-only when viewing the staging index rather than the working tree. */\\n    \\\"when\\\": \\\"isInDiffEditor && editorTextFocus && editorReadonly\\\",\\n    \\\"command\\\": \\\"git.unstageSelectedRanges\\\",\\n  },\\n  // {\\n  //   \\\"key\\\": \\\"r\\\",\\n  //   \\\"when\\\": \\\"isInDiffEditor && editorTextFocus\\\",\\n  //   \\\"command\\\": \\\"git.revertSelectedRanges\\\",\\n  // }\\n\\n  /* Toggle voice dictation. Requires VS Code Speech extension. */\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+s\\\",\\n    \\\"when\\\": \\\"!voiceChatInProgress\\\",\\n    \\\"command\\\": \\\"workbench.action.chat.startVoiceChat\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+s\\\",\\n    \\\"when\\\": \\\"voiceChatInProgress\\\",\\n    \\\"command\\\": \\\"workbench.action.chat.stopListeningAndSubmit\\\",\\n  },\\n\\n  /* Remove built-in shortcuts for Ctrl+Shift+s. */\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+s\\\",\\n    \\\"command\\\": \\\"-workbench.action.files.saveAs\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+s\\\",\\n    \\\"when\\\": \\\"editorLangId == 'markdown'\\\",\\n    \\\"command\\\": \\\"-markdown-preview-enhanced.syncPreview\\\",\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+shift+s\\\",\\n    \\\"when\\\": \\\"remoteFileDialogVisible\\\",\\n    \\\"command\\\": \\\"-workbench.action.files.saveLocalFile\\\",\\n  },\\n]\\n\",\"platform\":2}","snippets":"{\"snippets\":{\"global.code-snippets\":\"{\\n  \\\"Ellipsis\\\": {\\n    \\\"prefix\\\": \\\"...\\\",\\n    \\\"body\\\": [\\n      \\\"…\\\",\\n    ],\\n    \\\"description\\\": \\\"Replace three consecutive dots with an ellipsis\\\"\\n  },\\n  \\\"En_Dash\\\": {\\n    \\\"prefix\\\": \\\"--\\\",\\n    \\\"body\\\": [\\n      \\\"–\\\",\\n    ],\\n    \\\"description\\\": \\\"Replace double-hyphen with a single en-dash\\\"\\n  },\\n  \\\"Em_Dash\\\": {\\n    \\\"prefix\\\": \\\"---\\\",\\n    \\\"body\\\": [\\n      \\\"—\\\",\\n    ],\\n    \\\"description\\\": \\\"Replace triple-hyphen with a single em-dash\\\"\\n  },\\n  \\\"Right_Arrow\\\": {\\n    \\\"prefix\\\": \\\"->\\\",\\n    \\\"body\\\": [\\n      \\\"→\\\",\\n    ],\\n    \\\"description\\\": \\\"Replace dash + right angle bracket with right arrow\\\"\\n  },\\n  \\\"Left_Arrow\\\": {\\n    \\\"prefix\\\": \\\"<-\\\",\\n    \\\"body\\\": [\\n      \\\"←\\\",\\n    ],\\n    \\\"description\\\": \\\"Replace left angle bracket + dash with left arrow\\\"\\n  },\\n  \\\"Long_Right_Arrow\\\": {\\n    \\\"prefix\\\": \\\"-->\\\",\\n    \\\"body\\\": [\\n      \\\"🡒\\\",\\n    ],\\n    \\\"description\\\": \\\"Replace dash + dash + right angle bracket with 'rightwards sans-serif arrow'\\\"\\n  },\\n  \\\"Long_Left_Arrow\\\": {\\n    \\\"prefix\\\": \\\"<--\\\",\\n    \\\"body\\\": [\\n      \\\"🡐\\\",\\n    ],\\n    \\\"description\\\": \\\"Replace left angle bracket + dash + dash with 'leftwards sans-serif arrow'\\\"\\n  },\\n  \\\"Greater_Than_Or_Equal_To\\\": {\\n    \\\"prefix\\\": \\\">=\\\",\\n    \\\"body\\\": [\\n      \\\"≥\\\",\\n    ],\\n    \\\"description\\\": \\\"Replace right angle bracket + equal sign with greater-than-or-equal-to character\\\"\\n  },\\n  \\\"Less_Than_Or_Equal_To\\\": {\\n    \\\"prefix\\\": \\\"<=\\\",\\n    \\\"body\\\": [\\n      \\\"≤\\\",\\n    ],\\n    \\\"description\\\": \\\"Replace left angle bracket + equal sign with less-than-or-equal-to character\\\"\\n  },\\n  \\\"Plus or Minus\\\": {\\n    \\\"prefix\\\": \\\"+-\\\",\\n    \\\"body\\\": [\\n      \\\"±\\\",\\n    ],\\n    \\\"description\\\": \\\"Replace a plus sign followed by a minus sign with the plus-or-minus character\\\"\\n  },\\n}\"}}","extensions":"[{\"identifier\":{\"id\":\"asciidoctor.asciidoctor-vscode\",\"uuid\":\"c1309cc2-f420-46a3-b2be-ca04f4d9e51b\"},\"displayName\":\"AsciiDoc\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"editorconfig.editorconfig\",\"uuid\":\"f60a60a6-95ba-42d4-b41c-3d24c1b89588\"},\"displayName\":\"EditorConfig for VS Code\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"github.copilot\",\"uuid\":\"23c4aeee-f844-43cd-b53e-1113e483f1a6\"},\"displayName\":\"GitHub Copilot\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"github.copilot-chat\",\"uuid\":\"7ec7d6e6-b89e-4cc5-a59b-d6c4d238246f\"},\"displayName\":\"GitHub Copilot Chat\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"github.github-vscode-theme\",\"uuid\":\"7328a705-91fc-49e6-8293-da6f112e482d\"},\"displayName\":\"GitHub Theme\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"kieranpotts.ocean-vscode-theme\",\"uuid\":\"f899be62-59be-482d-91b5-5669576661da\"},\"displayName\":\"The Ocean\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ms-vscode-remote.remote-wsl\",\"uuid\":\"f0c5397b-d357-4197-99f0-cb4202f22818\"},\"displayName\":\"WSL\",\"applicationScoped\":false}]","globalState":"{\"storage\":{\"workbench.panel.chat.hidden\":\"[{\\\"id\\\":\\\"workbench.panel.chat.view.copilot\\\",\\\"isHidden\\\":false}]\",\"workbench.explorer.views.state.hidden\":\"[{\\\"id\\\":\\\"outline\\\",\\\"isHidden\\\":false},{\\\"id\\\":\\\"timeline\\\",\\\"isHidden\\\":false},{\\\"id\\\":\\\"workbench.explorer.openEditorsView\\\",\\\"isHidden\\\":true},{\\\"id\\\":\\\"workbench.explorer.emptyView\\\",\\\"isHidden\\\":false},{\\\"id\\\":\\\"workbench.explorer.fileView\\\",\\\"isHidden\\\":false},{\\\"id\\\":\\\"npm\\\",\\\"isHidden\\\":true},{\\\"id\\\":\\\"workbench.view.search\\\",\\\"isHidden\\\":false},{\\\"id\\\":\\\"github-copilot-completions-debugger-view\\\",\\\"isHidden\\\":false},{\\\"id\\\":\\\"copilot-chat\\\",\\\"isHidden\\\":false},{\\\"id\\\":\\\"context-inspector\\\",\\\"isHidden\\\":false},{\\\"id\\\":\\\"terraform.providers\\\",\\\"isHidden\\\":false},{\\\"id\\\":\\\"terraform.modu