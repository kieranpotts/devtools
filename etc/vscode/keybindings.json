[
  // Open external terminal in own window (start at current working directory).
  {
    "key": "ctrl+alt+t",
    "when": "!terminalFocus",
    "command": "workbench.action.terminal.openNativeConsole",
  },

  // Open external terminal in new tab (start at current working directory).
  {
    "key": "ctrl+shift+t",
    "when": "terminalProcessSupported",
    "command": "workbench.action.terminal.newWithCwd",
  },

  // Toggle zen mode.
  {
    "key": "ctrl+alt+z",
    "command": "workbench.action.toggleZenMode"
  },

  // Stage selected range
  {
    "key": "ctrl+space",
    "when": "isInDiffEditor && editorTextFocus",
    "command": "git.stageSelectedRanges",
    
  },
  {
    "key": "ctrl+space",
    // Diff editor is in read-only when viewing the staging index rather than the working tree.
    "when": "isInDiffEditor && editorTextFocus && editorReadonly",
    "command": "git.unstageSelectedRanges",
  },
  // {
  //   "key": "r",
  //   "when": "isInDiffEditor && editorTextFocus",
  //   "command": "git.revertSelectedRanges",
  // }

  // Toggle voice dictation. Requires VS Code Speech extension.
  {
    "key": "ctrl+shift+s",
    "when": "!voiceChatInProgress",
    "command": "workbench.action.chat.startVoiceChat",
  },
  {
    "key": "ctrl+shift+s",
    "when": "voiceChatInProgress",
    "command": "workbench.action.chat.stopListeningAndSubmit",
  },

  // Remove built-in shortcuts for Ctrl+Shift+s.
  {
    "key": "ctrl+shift+s",
    "command": "-workbench.action.files.saveAs"
  },
  {
    "key": "ctrl+shift+s",
    "when": "editorLangId == 'markdown'",
    "command": "-markdown-preview-enhanced.syncPreview",
  },
  {
    "key": "ctrl+shift+s",
    "when": "remoteFileDialogVisible",
    "command": "-workbench.action.files.saveLocalFile",
  }
]
